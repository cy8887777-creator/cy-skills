  "patterns": {
    "page-skeleton": "状态栏(88px) → 导航栏(88px，蓝底页反白/浅底页深字) → 内容区(左右边距 24px，卡片纵列 gap 24px) → 底部标签栏(116px 白底+上缘分隔线) → home 指示条(38px 安全区)；页面底 #F0F7FD",
    "status-color-semantics": "蓝 = 品牌/选中/可操作；橙 = 进行中/等待/强调；绿 = 已完成；红 = 删除/危险。状态标签一律『同色 12% tint 底 + 同色实色 24px/700 文字』",
    "gradient-strategy": "渐变只用于：主按钮底、功能图标圆底、装饰横幅/资料卡底、图片→页面底渐隐遮罩；卡片与控件常态一律纯色",
    "shadow-strategy": "阴影全部带蓝调（rgba(7,126,250,*) / rgba(20,90,180,*)），禁用纯黑阴影；悬浮元素 = 强阴影 + 白色描边环组合",
    "spacing-rhythm": "4pt 网格，主档 8/12/16/20/24/32/40；卡片间 gap 24、区块间 gap 32、页面左右边距 24；低频散值（5.77/11.54/13.46/21.15/23.08/63px）就近归档不立档",
    "elevation-map": "地图场景元素（价格卡/骑手标记）用高投影 + 白环悬浮于地图之上，z 轴高于一切卡片",
    "typography-mix": "中文用 Noto Sans SC，数字/时间/金额用 SF Pro；标题 700、按钮 500-700、正文 400；行高正文 1.45、小字 1.5"
  },
